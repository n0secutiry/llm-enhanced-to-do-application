# dev enables /docs, prod hides it
ENV='dev'
LOG_FILE=/logs/app.log

MONGO_ROOT_USER=user
MONGO_ROOT_PASSWORD=password
MONGO_NAME_DB=name_db
# Inside docker compose this is the service name; from the host use localhost
MONGO_HOST_DB=mongodb_services
MONGO_PORT_DB=27017
MONGO_TIMEOUT_SELECTION_SERVER_MS=5000
MONGO_TIMEOUT_CONNECT_MS=3000

# mongo-express (optional profile "tools")
ME_CONFIG_BASICAUTH_USERNAME=user
ME_CONFIG_BASICAUTH_PASSWORD=password

# Ollama runs on the host, so a container reaches it via host.docker.internal
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_S=30
OLLAMA_INPUT_LIMIT=2000

# Prioritise a new todo in the background right after it is created
AUTO_PRIORITIZE=true

# Priority formula weights: score = w1*urgency + w2*(6-effort) + w3*blocks_others
PRIORITY_WEIGHT_URGENCY=2.0
PRIORITY_WEIGHT_EFFORT=1.0
PRIORITY_WEIGHT_BLOCKS=1.5

# Rate limit for the endpoints that call the model
LLM_RATE_LIMIT_REQUESTS=10
LLM_RATE_LIMIT_WINDOW_S=60

# LangFuse tracing stays off while the keys are empty
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
